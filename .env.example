# Copy to .env only when deploying to Sepolia.
# Never commit a real private key or API key.
SEPOLIA_RPC_URL=https://YOUR_SEPOLIA_RPC_ENDPOINT
SEPOLIA_PRIVATE_KEY=0xYOUR_TEST_WALLET_PRIVATE_KEY
# Set after deployment if using scripts that require the deployed address:
FIRE_INSURANCE_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS
